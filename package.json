{
	"name": "@pajecawav/yamf",
	"type": "module",
	"version": "0.0.1",
	"description": "Yet another meta framework",
	"license": "MIT",
	"homepage": "https://github.com/pajecawav/yamf#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pajecawav/yamf.git"
	},
	"bugs": {
		"url": "https://github.com/pajecawav/yamf/issues"
	},
	"exports": {
		".": "./dist/index.js",
		"./vite": "./dist/vite/index.mjs",
		"./client": "./dist/client/index.js",
		"./server": "./dist/server/index.mjs",
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"lint": "run-p -l lint:*",
		"lint:oxlint": "oxlint .",
		"lint:tsc": "tsc -b --noEmit",
		"lint:format": "pt format --check",
		"lint:package": "publint",
		"format": "pt format",
		"prepare": "husky",
		"prepublishOnly": "cross-env FORCE_COLOR=1 npm-run-all -l -s build -p lint:* test"
	},
	"peerDependencies": {
		"hono": "^4.12.12",
		"vite": "^8.0.0"
	},
	"dependencies": {
		"@babel/generator": "^7.29.1",
		"@babel/parser": "^7.29.3",
		"@babel/traverse": "^7.29.0",
		"@babel/types": "^7.29.0",
		"devalue": "^5.8.0",
		"nitro": "3.0.260429-beta",
		"rou3": "^0.8.1",
		"ufo": "^1.6.4",
		"unhead": "^3.1.0"
	},
	"devDependencies": {
		"@pajecawav/tools": "^0.0.2",
		"@types/babel__generator": "^7.27.0",
		"@types/babel__traverse": "^7.28.0",
		"@types/node": "^24.12.2",
		"@vitest/coverage-v8": "^4.1.5",
		"@vitest/ui": "^4.1.5",
		"cross-env": "^10.1.0",
		"husky": "^9.1.7",
		"npm-run-all2": "^8.0.4",
		"oxfmt": "^0.48.0",
		"oxlint": "^1.63.0",
		"oxlint-tsgolint": "^0.22.1",
		"publint": "^0.3.18",
		"tsdown": "0.21.10",
		"typescript": "^6.0.3",
		"vite": "^8.0.10",
		"vitest": "^4.1.5"
	},
	"packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
