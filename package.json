{
	"name": "yamf",
	"type": "module",
	"version": "0.0.0",
	"description": "Yet another meta framework",
	"license": "MIT",
	"homepage": "https://github.com/pajecawav/yamf#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pajecawav/yamf.git"
	},
	"bugs": {
		"url": "https://github.com/pajecawav/yamf/issues"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite/index.d.mts",
			"default": "./dist/vite/index.mjs"
		},
		"./client": {
			"types": "./dist/client/index.d.ts",
			"default": "./dist/client/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.mts",
			"default": "./dist/server/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"lint": "run-p -l lint:*",
		"lint:eslint": "eslint .",
		"lint:tsc": "tsc -b --noEmit",
		"lint:format": "prettier . --check",
		"lint:package": "publint",
		"format": "prettier . --write",
		"prepare": "husky",
		"prepublishOnly": "cross-env FORCE_COLOR=1 npm-run-all -l -s build -p lint:* test"
	},
	"pnpm": {
		"overrides": {
			"vite": "^8.0.0-beta.13"
		}
	},
	"peerDependencies": {
		"hono": "^4.12.12",
		"vite": "^8.0.0"
	},
	"dependencies": {
		"@babel/generator": "^7.29.1",
		"@babel/parser": "^7.29.2",
		"@babel/traverse": "^7.29.0",
		"@babel/types": "^7.29.0",
		"devalue": "^5.7.1",
		"nitro": "3.0.260415-beta",
		"rou3": "^0.8.1",
		"ufo": "^1.6.3",
		"unhead": "^3.0.5"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@eslint/js": "^10.0.1",
		"@pajecawav/prettier-config": "^1.0.0",
		"@types/babel__generator": "^7.27.0",
		"@types/babel__traverse": "^7.28.0",
		"@types/node": "^24.12.2",
		"@vitest/coverage-v8": "^4.1.5",
		"@vitest/ui": "^4.1.5",
		"cross-env": "^10.1.0",
		"eslint": "^10.2.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"npm-run-all2": "^8.0.4",
		"prettier": "^3.8.3",
		"publint": "^0.3.18",
		"tsdown": "0.21.9",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.0",
		"vite": "^8.0.0",
		"vitest": "^4.1.5"
	},
	"packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4"
}
