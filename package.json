{
	"name": "@pajecawav/yamf",
	"type": "module",
	"version": "0.0.3",
	"description": "Yet another meta framework",
	"license": "MIT",
	"homepage": "https://github.com/pajecawav/yamf#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pajecawav/yamf.git"
	},
	"bugs": {
		"url": "https://github.com/pajecawav/yamf/issues"
	},
	"exports": {
		".": "./dist/index.js",
		"./vite": "./dist/vite/index.mjs",
		"./client": "./dist/client/index.js",
		"./server": "./dist/server/index.mjs",
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"play": "pnpm --filter=playground dev",
		"play:build": "pnpm --filter=playground build",
		"play:preview": "pnpm --filter=playground preview",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"lint": "cross-env FORCE_COLOR=1 run-p -l lint:*",
		"lint:oxlint": "oxlint .",
		"lint:tsc": "tsgo -b --noEmit",
		"lint:format": "pt format --check",
		"lint:package": "publint",
		"format": "pt format",
		"prepare": "pt prepare",
		"prepublishOnly": "cross-env FORCE_COLOR=1 npm-run-all -l -s build -p lint:* test"
	},
	"peerDependencies": {
		"hono": "^4.12.23",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@babel/generator": "^7.29.7",
		"@babel/parser": "^7.29.7",
		"@babel/traverse": "^7.29.7",
		"@babel/types": "^7.29.7",
		"devalue": "^5.8.1",
		"exsolve": "^1.0.8",
		"nitro": "3.0.260610-beta",
		"rou3": "^0.8.1",
		"ufo": "^1.6.4",
		"unhead": "^3.1.4"
	},
	"devDependencies": {
		"@pajecawav/tools": "^0.0.4",
		"@types/babel__generator": "^7.27.0",
		"@types/babel__traverse": "^7.28.0",
		"@types/node": "^24.13.2",
		"@typescript/native-preview": "7.0.0-dev.20260612.1",
		"@vitest/coverage-v8": "^4.1.8",
		"@vitest/ui": "^4.1.8",
		"cross-env": "^10.1.0",
		"hono": "^4.12.25",
		"husky": "^9.1.7",
		"npm-run-all2": "^9.0.1",
		"oxfmt": "^0.54.0",
		"oxlint": "^1.69.0",
		"oxlint-tsgolint": "^0.23.0",
		"publint": "^0.3.21",
		"tsdown": "0.22.2",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"packageManager": "pnpm@11.5.2"
}
