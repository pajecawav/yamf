{
	"name": "@pajecawav/yamf",
	"type": "module",
	"version": "0.0.6",
	"description": "Yet another meta framework",
	"license": "MIT",
	"homepage": "https://github.com/pajecawav/yamf#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pajecawav/yamf.git"
	},
	"bugs": {
		"url": "https://github.com/pajecawav/yamf/issues"
	},
	"exports": {
		".": "./dist/index.js",
		"./vite": "./dist/vite/index.mjs",
		"./client": "./dist/client/index.js",
		"./server": "./dist/server/index.mjs",
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"play": "pnpm --filter=playground dev",
		"play:build": "pnpm --filter=playground build",
		"play:preview": "pnpm --filter=playground preview",
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"lint": "cross-env FORCE_COLOR=1 run-p -l lint:*",
		"lint:oxlint": "oxlint .",
		"lint:tsc": "tsc -b --noEmit",
		"lint:format": "pt format --check",
		"lint:package": "publint",
		"format": "pt format",
		"prepare": "pt prepare",
		"prepublishOnly": "cross-env FORCE_COLOR=1 npm-run-all -l -s build -p lint:* test"
	},
	"peerDependencies": {
		"hono": "^4.12.30",
		"vite": "^8.1.5"
	},
	"dependencies": {
		"@hono/react-compat": "^0.0.3",
		"devalue": "^5.8.2",
		"exsolve": "^1.1.0",
		"nitro": "3.0.260610-beta",
		"rolldown-string": "^0.3.1",
		"rou3": "^0.9.1",
		"ufo": "^1.6.4",
		"unhead": "^3.2.3",
		"wouter": "^3.10.0"
	},
	"devDependencies": {
		"@hono/react-compat": "^0.0.3",
		"@pajecawav/tools": "^0.0.7",
		"@playwright/test": "^1.61.1",
		"@types/node": "^24.13.3",
		"cross-env": "^10.1.0",
		"hono": "^4.12.32",
		"husky": "^9.1.7",
		"npm-run-all2": "^9.0.2",
		"oxfmt": "^0.60.0",
		"oxlint": "^1.75.0",
		"oxlint-tsgolint": "^7.0.2001",
		"publint": "^0.3.22",
		"tsdown": "0.22.14",
		"typescript": "~7.0.2",
		"vite": "^8.1.5"
	},
	"packageManager": "pnpm@11.15.0"
}
